# This file excludes paths from the Docker build context.
.dockerignore

# Ignore git
.git
!.git/HEAD
!.git/refs

# Common development/test artifacts
/cover/
/doc/
/test/
/tmp/
.elixir_ls

# Mix artifacts
/_build/
/deps/
*.ez

# Generated on crash by the VM
erl_crash.dump

# Static artifacts
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# macOS
.DS_Store
*.DS_Store
