<!DOCTYPE html>
<html lang="pt-BR" data-theme="light" class="bg-white text-black">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <.live_title default="Kcal" suffix=" · Cálculo Nutricional">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- html-to-image rasterizes the label via SVG <foreignObject>, so it
          renders modern CSS (oklch, color-mix) natively — unlike html2canvas. --%>
    <script defer src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.13/dist/html-to-image.js">
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-white text-black min-h-screen antialiased">
    {@inner_content}
  </body>
</html>
